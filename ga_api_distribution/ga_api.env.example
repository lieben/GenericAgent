# Copy to ga_api.env and fill in THIS machine's values.
# Do not send ga_api.env to anyone. Do not commit it.
# start_ga_api.sh sources ga_api.env automatically if the file exists.

# Required: Bearer token for /v1/chat/completions (generate locally)
export GA_API_KEY='replace-with-a-long-random-string'

# Required in this release: desktop bridge used to live under ga_api_config.json "bridge"
export GA_DESKTOP_BRIDGE_URL='http://127.0.0.1:14168'
export GA_XAVIER_SESSION_ID='replace-with-this-machine-session-id'
# Optional:
# export GA_XAVIER_SESSION_TITLE='desktop-session'

# Optional MemPalace handset — leave commented unless the holder confirmed a palace
# export MEMPALACE_MCP_URL='http://127.0.0.1:8765/mcp'
# export MEMPALACE_MCP_HTTP_TOKEN=''
